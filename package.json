{
  "name": "holocron-emulator-monorepo",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "verify:abi": "node scripts/verify-abi.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package-release.mjs",
    "check": "npm test && npm run verify:abi && npm run verify:release"
  },
  "engines": {
    "node": ">=20"
  }
}
